      "source": [
        "# ID3 (Iterative Dichotomiser 3)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "46f85012",
      "metadata": {
        "id": "46f85012"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "class TreeNode:\n",
        "    def __init__(self, ids=None, children=None, entropy=0, depth=0):\n",
        "        self.ids = ids                # vị trí (0-based) các dòng dữ liệu thuộc nút này\n",
        "        self.entropy = entropy        # entropy của nút\n",
        "        self.depth = depth            # khoảng cách tới nút gốc\n",
        "        self.split_attribute = None   # thuộc tính được chọn để tách (nếu là nút trong)\n",
        "        self.children = children if children is not None else []  # tránh mutable default argument\n",
        "        self.order = None             # thứ tự các giá trị của split_attribute tương ứng với children\n",
        "        self.label = None             # nhãn của nút nếu là lá\n",
        "\n",
        "    def set_properties(self, split_attribute, order):\n",
        "        self.split_attribute = split_attribute\n",
        "        self.order = order\n",
        "\n",
        "    def set_label(self, label):\n",
        "        self.label = label"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "52362e58",
      "metadata": {
        "id": "52362e58"
      },
      "outputs": [],
      "source": [
        "LOG_BASE = 2   # 2\n",
        "\n",
        "\n",
        "def entropy(freq):\n",
        "    \"\"\"Entropy từ danh sách tần số các lớp, ví dụ entropy([9, 5]) = 0.940.\"\"\"\n",
        "    freq = np.asarray(freq, dtype=float)\n",
        "    freq = freq[freq > 0]\n",
        "    if freq.size == 0:\n",
        "        return 0.0\n",
        "    prob = freq / freq.sum()\n",
        "    h = -np.sum(prob * np.log(prob)) / np.log(LOG_BASE)\n",
        "    return float(h) + 0.0                 # +0.0 để nút thuần nhất ra 0.0 thay vì -0.0"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "fdb09f7b",
      "metadata": {
        "id": "fdb09f7b"
      },
      "outputs": [],
      "source": [
        "class DecisionTreeID3:\n",
        "    def __init__(self, max_depth=10, min_samples_split=2, min_samples_leaf=1, min_gain=1e-4):\n",
        "        self.root = None\n",
        "        self.max_depth = max_depth                  # độ sâu tối đa của cây\n",
        "        self.min_samples_split = min_samples_split  # nút phải có ít nhất ngần này mẫu mới được tách\n",
        "        self.min_samples_leaf = min_samples_leaf    # mỗi nhánh con sau khi tách phải có ít nhất ngần này mẫu\n",
        "        self.min_gain = min_gain                    # information gain tối thiểu để chấp nhận một phép tách\n",
        "        self.Ntrain = 0\n",
        "        self.gains = {}                             # gain của từng thuộc tính ở nút vừa xét (dùng cho animation)\n",
        "\n",
        "    def fit(self, data, target):\n",
        "        # reset index để vị trí dòng == nhãn index, không còn bắt buộc index phải bắt đầu từ 1\n",
        "        self.data = data.reset_index(drop=True)\n",
        "        self.target = target.reset_index(drop=True)\n",
        "        if len(self.data) != len(self.target):\n",
        "            raise ValueError(\"data và target phải có cùng số dòng\")\n",
        "        self.Ntrain = len(self.data)\n",
        "        self.attributes = list(self.data.columns)\n",
        "        self.labels = self.target.unique()\n",
        "\n",
        "        ids = list(range(self.Ntrain))\n",
        "        self.root = TreeNode(ids=ids, entropy=self._entropy(ids), depth=0)\n",
        "        queue = [self.root]\n",
        "        while queue:\n",
        "            node = queue.pop()\n",
        "            self.gains = {}\n",
        "            can_split = (node.depth < self.max_depth\n",
        "                         and node.entropy > self.min_gain          # nút đã thuần nhất thì không tách nữa\n",
        "                         and len(node.ids) >= self.min_samples_split)\n",
        "            if can_split:\n",
        "                node.children = self._split(node)\n",
        "                if not node.children:                              # không có phép tách tốt -> lá\n",
        "                    self._set_label(node)\n",
        "                queue += node.children\n",
        "            else:\n",
        "                self._set_label(node)\n",
        "            self._on_node_done(node)\n",
        "\n",
        "    def _on_node_done(self, node):\n",
        "        \"\"\"Hook gọi sau khi xử lý xong mỗi nút (lớp con dùng để ghi lại animation).\"\"\"\n",
        "        pass\n",
        "\n",
        "    def _entropy(self, ids):\n",
        "        ids = list(ids)\n",
        "        if len(ids) == 0:\n",
        "            return 0.0\n",
        "        return entropy(self.target.iloc[ids].value_counts().to_numpy())\n",
        "\n",
        "    def _majority_label(self, ids):\n",
        "        label = self.target.iloc[list(ids)].mode().iloc[0]   # nhãn xuất hiện nhiều nhất\n",
        "        return label.item() if hasattr(label, \"item\") else label  # numpy -> kiểu Python thuần\n",
        "\n",
        "    def _set_label(self, node):\n",
        "        node.set_label(self._majority_label(node.ids))\n",
        "\n",
        "    def _split(self, node):\n",
        "        ids = np.array(node.ids)\n",
        "        best_gain, best_splits, best_attribute, order = 0, [], None, None\n",
        "        sub_data = self.data.iloc[ids]\n",
        "        for att in self.attributes:\n",
        "            column = sub_data[att].to_numpy()\n",
        "            values = sub_data[att].unique().tolist()\n",
        "            if len(values) == 1:\n",
        "                continue                                           # entropy = 0, không có gì để tách\n",
        "            splits = [ids[column == val].tolist() for val in values]\n",
        "            if min(len(s) for s in splits) < self.min_samples_leaf:\n",
        "                continue                                           # có nhánh con quá nhỏ\n",
        "            HxS = sum(len(s) * self._entropy(s) / len(ids) for s in splits)\n",
        "            gain = node.entropy - HxS\n",
        "            self.gains[att] = gain\n",
        "            if gain < self.min_gain:\n",
        "                continue\n",
        "            if gain > best_gain:\n",
        "                best_gain, best_splits, best_attribute, order = gain, splits, att, values\n",
        "        node.set_properties(best_attribute, order)\n",
        "        return [TreeNode(ids=s, entropy=self._entropy(s), depth=node.depth + 1) for s in best_splits]\n",
        "\n",
        "    def predict(self, new_data):\n",
        "        \"\"\"\n",
        "        :param new_data: DataFrame, mỗi dòng là một điểm dữ liệu (cùng tên cột với lúc train)\n",
        "        :return: list nhãn dự đoán cho từng dòng\n",
        "        \"\"\"\n",
        "        labels = []\n",
        "        for _, row in new_data.iterrows():\n",
        "            node = self.root\n",
        "            while node.children:\n",
        "                value = row[node.split_attribute]\n",
        "                if value not in node.order:\n",
        "                    # giá trị chưa từng gặp lúc train -> trả về nhãn đa số của nút hiện tại\n",
        "                    label = self._majority_label(node.ids)\n",
        "                    break\n",
        "                node = node.children[node.order.index(value)]\n",
        "            else:\n",
        "                label = node.label\n",
        "            labels.append(label)\n",
        "        return labels"
      ]
    },
