        "import sys\n",
        "from pathlib import Path\n",
        "DATA_DIR = None\n",
        "\n",
        "IN_COLAB = \"google.colab\" in sys.modules\n",
        "\n",
        "\n",
        "def _candidate_dirs():\n",
        "    cwd = Path.cwd()\n",
        "    dirs = []\n",
        "    if DATA_DIR:\n",
        "        dirs.append(Path(DATA_DIR).expanduser())\n",
        "    dirs += [cwd, cwd / \"data\", cwd.parent / \"data\",\n",
        "             Path(\"/content\"), Path(\"/content/data\"),\n",
        "             Path(\"/content/drive/MyDrive\"), Path(\"/content/drive/MyDrive/Colab Notebooks\")]\n",
        "    result = []\n",
        "    for d in dirs:\n",
        "        if d.is_dir() and d not in result:\n",
        "            result.append(d)\n",
        "    return result\n",
        "\n",
        "\n",
        "def resolve_csv(csv_path):\n",
        "    \"\"\"Trả về đường dẫn thật của file CSV; trên Colab nếu không thấy thì mở hộp thoại upload.\"\"\"\n",
        "    p = Path(csv_path).expanduser()\n",
        "    if p.is_absolute():\n",
        "        if p.exists():\n",
        "            return p\n",
        "        searched = [p.parent]\n",
        "    else:\n",
        "        searched = _candidate_dirs()\n",
        "        for d in searched:\n",
        "            if (d / p).exists():\n",
        "                return d / p\n",
        "    if IN_COLAB:\n",
        "        from google.colab import files\n",
        "        print(f\"Không thấy {p.name}. Hãy chọn file CSV từ máy để upload (có thể chọn nhiều file một lúc)...\")\n",
        "        files.upload()                       # file được lưu vào thư mục hiện tại (/content)\n",
        "        uploaded = Path.cwd() / p.name\n",
        "        if uploaded.exists():\n",
        "            return uploaded\n",
        "    raise FileNotFoundError(\n",
        "        f\"Không tìm thấy {p.name!r}. Đã tìm trong: {[str(d) for d in searched]}. \"\n",
        "        f\"Hãy đặt CSV cùng cấp với notebook hoặc chỉnh DATA_DIR.\"\n",
        "    )\n",
        "\n",
        "\n",
        "def read_id3_csv(csv_path):\n",
        "    \"\"\"Đọc CSV (UTF-8/UTF-8-SIG, dự phòng cp1258 của Windows tiếng Việt), bỏ khoảng trắng thừa.\"\"\"\n",
        "    path = resolve_csv(csv_path)\n",
        "    try:\n",
        "        df = pd.read_csv(path, encoding=\"utf-8-sig\")\n",
        "    except UnicodeDecodeError:\n",
        "        df = pd.read_csv(path, encoding=\"cp1258\")\n",
        "    df.columns = [str(c).strip() for c in df.columns]\n",
        "    for c in df.columns:\n",
        "        if not pd.api.types.is_numeric_dtype(df[c]):\n",
        "            df[c] = df[c].map(lambda v: v.strip() if isinstance(v, str) else v)\n",
        "    return df\n",
        "\n",
        "\n",
        "def load_id3_data(csv_path, target_col, id_cols=()):\n",
        "    \"\"\"Đọc CSV và tách thành (df gốc, X thuộc tính, y nhãn); X, y có index 0..n-1.\"\"\"\n",
        "    df = read_id3_csv(csv_path)\n",
        "    if target_col not in df.columns:\n",
        "        raise ValueError(f\"Không tìm thấy cột nhãn {target_col!r}; các cột: {list(df.columns)}\")\n",
        "    ignored = [c for c in id_cols if c in df.columns]\n",
        "    X = df.drop(columns=[target_col, *ignored]).copy()\n",
        "    y = df[target_col].copy()\n",
        "    if X.shape[1] == 0:\n",
        "        raise ValueError(\"Không còn thuộc tính đầu vào sau khi bỏ cột nhãn/ID.\")\n",
        "    # ID3 chia theo giá trị rời rạc; từ chối số liên tục để tránh chia sai.\n",
        "    numeric = [c for c in X.columns if pd.api.types.is_numeric_dtype(X[c])]\n",
        "    if numeric:\n",
        "        raise ValueError(f\"ID3 hiện chỉ hỗ trợ thuộc tính phân loại; cần xử lý cột liên tục: {numeric}\")\n",
        "    if y.isna().any():\n",
        "        raise ValueError(\"Cột nhãn có giá trị thiếu; hãy xử lý trước khi huấn luyện.\")\n",
        "    missing = X.columns[X.isna().any()].tolist()\n",
        "    if missing:\n",
        "        print(f\"Cảnh báo: cột {missing} có giá trị thiếu, được coi là một giá trị riêng 'Thiếu'.\")\n",
        "        X = X.fillna(\"Thiếu\")\n",
        "    return df, X.reset_index(drop=True), y.reset_index(drop=True)\n",
        "\n",
        "\n",
        "def print_tree_rules(node, conditions=None):\n",
        "    \"\"\"In cây thành các luật từ gốc đến từng nút lá.\"\"\"\n",
        "    conditions = conditions or []\n",
        "    if not node.children:\n",
        "        rule = \" AND \".join(conditions) if conditions else \"TRUE\"\n",
        "        print(f\"IF {rule} THEN {node.label}\")\n",
        "        return\n",
        "    for value, child in zip(node.order, node.children):\n",
        "        print_tree_rules(child, conditions + [f\"{node.split_attribute} = {value}\"])\n",
        "\n",
        "\n",
        "def run_id3(csv_path, target_col, id_cols=(), max_depth=3, min_samples_split=2, min_samples_leaf=2):\n",
        "    \"\"\"Đọc một CSV, huấn luyện ID3 và in dữ liệu, dự đoán, luật.\n",
        "\n",
        "    min_samples_leaf=2: mỗi nhánh con phải có >= 2 mẫu (giống hành vi cũ của code).\n",
        "    Đặt min_samples_leaf=1 nếu muốn cây sâu hơn (dễ khớp quá mức với dữ liệu nhỏ).\n",
        "    \"\"\"\n",
        "    path = resolve_csv(csv_path)\n",
        "    df, X, y = load_id3_data(path, target_col, id_cols)\n",
        "    tree = DecisionTreeID3(max_depth=max_depth, min_samples_split=min_samples_split,\n",
        "                           min_samples_leaf=min_samples_leaf)\n",
        "    tree.fit(X, y)\n",
        "    pred = tree.predict(X)\n",
        "    acc = sum(p == t for p, t in zip(pred, y)) / len(y)\n",
        "    print(\"Đường dẫn:\", path)\n",
        "    print(\"Kích thước:\", X.shape, \"| cột nhãn:\", target_col)\n",
        "    print(\"Các cột:\", list(X.columns), \"| phân bố nhãn:\", y.value_counts().to_dict())\n",
        "    print(\"Dữ liệu:\")\n",
        "    print(df.to_string(index=False))\n",
        "    print(\"Dự đoán trên dữ liệu:\", pred)\n",
        "    print(f\"Độ chính xác trên tập huấn luyện: {acc:.2%}\")\n",
        "    print(\"Luật quyết định:\")\n",
        "    print_tree_rules(tree.root)\n",
        "    return X, y, tree"
      ]
    },
